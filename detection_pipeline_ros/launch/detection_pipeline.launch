<?xml version="1.0"?>
<launch>
  <!-- Detection pipeline launch file for ROS 1 Noetic -->

  <!-- Arguments -->
  <arg name="frame_topic" default="/udp/frame" />
  <arg name="detections_topic" default="/udp/detections" />
  <arg name="lidar_topic" default="/livox/lidar" />
  <arg name="imu_topic" default="/livox/imu" />
  <arg name="output_frame_topic" default="/detection/frame" />
  <arg name="segmentation_mask_topic" default="/detection/segmentation_masks" />
  <arg name="best_candidate_topic" default="/detection/best_candidate" />
  <arg name="debug_image_topic" default="" />
  <arg name="sync_queue_size" default="10" />
  <arg name="sync_slop" default="0.05" />
  <arg name="sensor_timeout" default="1.0" />

  <!-- Detection node -->
  <node pkg="detection_pipeline_ros" type="detection_node.py" name="detection_pipeline_node" output="screen">
    <param name="frame_topic" value="$(arg frame_topic)" />
    <param name="detections_topic" value="$(arg detections_topic)" />
    <param name="lidar_topic" value="$(arg lidar_topic)" />
    <param name="imu_topic" value="$(arg imu_topic)" />
    <param name="output_frame_topic" value="$(arg output_frame_topic)" />
    <param name="segmentation_mask_topic" value="$(arg segmentation_mask_topic)" />
    <param name="best_candidate_topic" value="$(arg best_candidate_topic)" />
    <param name="debug_image_topic" value="$(arg debug_image_topic)" />
    <param name="sync_queue_size" value="$(arg sync_queue_size)" />
    <param name="sync_slop" value="$(arg sync_slop)" />
    <param name="sensor_timeout" value="$(arg sensor_timeout)" />
  </node>

</launch>
