<?xml version="1.0"?>
<package>
  <name>detection_pipeline_ros</name>
  <version>0.0.1</version>
  <description>UAV branch detection pipeline for autonomous landing - ROS 1 Noetic package</description>

  <maintainer email="baraa@example.com">Baraa</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- ROS core dependencies -->
  <build_depend>rospy</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>cv_bridge</build_depend>

  <!-- Python runtime dependencies -->
  <run_depend>rospy</run_depend>
  <run_depend>sensor_msgs</run_depend>
  <run_depend>geometry_msgs</run_depend>
  <run_depend>std_msgs</run_depend>
  <run_depend>cv_bridge</run_depend>

</package>
