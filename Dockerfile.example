# Dockerfile example for ROS 1 Noetic container with detection pipeline

FROM ros:noetic

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3-pip \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create workspace
RUN mkdir -p /root/catkin_ws/src

WORKDIR /root/catkin_ws

# Copy detection pipeline package
COPY detection_pipeline_ros /root/catkin_ws/src/detection_pipeline_ros

# Install Python dependencies
RUN pip3 install -r src/detection_pipeline_ros/requirements.txt

# Source ROS setup
RUN echo "source /opt/ros/noetic/setup.bash" >> ~/.bashrc && \
    echo "source /root/catkin_ws/devel/setup.bash" >> ~/.bashrc

# Build the package
RUN bash -c "source /opt/ros/noetic/setup.bash && catkin_make"

# Set entrypoint
ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/noetic/setup.bash && source /root/catkin_ws/devel/setup.bash && exec \"$@\"", "--"]

# Default command: run the node
CMD ["roslaunch", "detection_pipeline_ros", "detection_pipeline.launch"]
